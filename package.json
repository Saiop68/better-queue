{
  "name": "@destroyer777777/betterqueue",
  "version": "1.0.0",
  "description": "High-performance, memory-efficient, distributed rate limiter and job queue for Node.js \u2014 Redis-backed, zero per-limiter timers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./LimiterManager": {
      "types": "./dist/LimiterManager.d.ts",
      "import": "./dist/LimiterManager.mjs",
      "require": "./dist/LimiterManager.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build:lua": "node build-lua.js",
    "build": "npm run build:lua && tsup src/index.ts src/LimiterManager.ts --format cjs,esm --dts --clean --sourcemap",
    "dev": "tsup src/index.ts src/LimiterManager.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "example:basic": "ts-node -r tsconfig-paths/register examples/basic.ts",
    "example:benchmark": "ts-node -r tsconfig-paths/register examples/benchmark.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "rate-limiter",
    "job-queue",
    "redis",
    "bottleneck",
    "distributed",
    "memory-efficient",
    "typescript",
    "ioredis",
    "token-bucket",
    "backpressure",
    "crash-recovery",
    "distributed-systems"
  ],
  "author": "Saiop68",
  "license": "MIT",
  "dependencies": {
    "ioredis": "^5.3.2",
    "lru-cache": "^11.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saiop68/better-queue.git"
  },
  "homepage": "https://github.com/Saiop68/better-queue#readme",
  "bugs": {
    "url": "https://github.com/Saiop68/better-queue/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "Saiop68"
  ]
}
